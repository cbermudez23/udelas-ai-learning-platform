# ============================================================
# UDELAS AI Learning Platform — Variables de entorno (ejemplo)
# Copia este archivo como ".env" para desarrollo local,
# o configura estas mismas variables en el panel de Render.
# ============================================================

# Cadena de conexión a PostgreSQL.
# En Render, si usas el Blueprint (render.yaml), esta variable
# se rellena automáticamente al enlazar la base de datos.
DATABASE_URL="postgresql://usuario:password@localhost:5432/udelas_ai_platform"

# Clave secreta usada por NextAuth para firmar sesiones (JWT).
# Genera una con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-esto-con-una-clave-segura-y-aleatoria"

# URL pública donde corre la aplicación (sin barra final).
# En local: http://localhost:3000
# En Render: https://udelas-ai-learning-platform.onrender.com
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------
# Proveedor de Inteligencia Artificial (elige UNO de los dos)
# El Tutor IA (UALE), los Agentes Docentes, el generador de
# exámenes y la Biblioteca IA usan la que esté configurada.
# Si ambas están presentes, se usa Anthropic (Claude) primero.
# ------------------------------------------------------------

# Opción A — Claude (Anthropic)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Opción B — OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------
# Conexión LTI 1.3 con Moodle
# Estos valores se obtienen en dos pasos:
#  1. MOODLE_ISSUER, MOODLE_AUTH_LOGIN_URL y MOODLE_JWKS_URL se arman
#     con la URL de tu Moodle (ver README para el detalle exacto).
#  2. MOODLE_CLIENT_ID y MOODLE_DEPLOYMENT_ID los genera Moodle
#     automáticamente cuando registras esta plataforma como
#     "herramienta externa" — solo los sabrás DESPUÉS de registrarla.
# ------------------------------------------------------------
MOODLE_ISSUER="https://produccion.udelassandboxmoodle.org"
MOODLE_AUTH_LOGIN_URL="https://produccion.udelassandboxmoodle.org/mod/lti/auth.php"
MOODLE_JWKS_URL="https://produccion.udelassandboxmoodle.org/mod/lti/certs.php"
MOODLE_CLIENT_ID=""
MOODLE_DEPLOYMENT_ID=""

# Llave privada propia de esta plataforma (para firmar hacia Moodle en el futuro).
# Generada una sola vez; nunca debe compartirse ni subirse a GitHub.
LTI_TOOL_PRIVATE_KEY=""
